@page "/employees"
@rendermode InteractiveServer
@using EmployeeManager.Services
@using EmployeeManager.Models
@inject EmployeeService employeeService

<PageTitle>Employees</PageTitle>

<h3>Employee Management</h3>

<p>Total Employee Count: @employeeCount</p>


<form @onsubmit="AddEmployee" @onsubmit:preventDefault>
    <div>
        <label>Employee Name:</label>
        <input @bind="employeeName"/>
    </div>
    <div>
        <label>Employee Department:</label>
        <input @bind="employeeDepartment" />
    </div>
    @if (!string.IsNullOrWhiteSpace(errorMessage)){
        <div>
            <label>@errorMessage</label>
        </div>
    }
    <div>
        <input type="submit" value="Add Employee" />
    </div>
</form>


    <div>
        <label>Search:</label>
        <input @bind="searchContent" placeholder="Search employees..."/>
        <button @onclick="() => SearchEmployee(searchContent)">Search</button>
        
    @if (!string.IsNullOrWhiteSpace(searchMessage))
    {
        <p>@searchMessage</p>
    }

    </div>


@if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}
<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Department</th>
            <th>Hire Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in employees)
        {
            <tr>
                <td>@employee.Id</td>
                <td>
                    @if(employeeIdToUpdate == employee.Id)
                    {
                        <input @bind="editName" />
                    }
                    else
                    {
                        @employee.Name
                    }
                    
                </td>
                <td>
                    @if(employeeIdToUpdate == employee.Id){
                        <input @bind="editDepartment"/>
                    }
                    else
                    {
                        @employee.Department
                        
                    }
                </td>
                <td>@employee.HireDate.ToString("dd.MM.yyyy")</td>
                <td>@if(employeeIdToUpdate == employee.Id)
                {
                    <button @onclick="() => UpdateEmployee(employee.Id, editName, editDepartment)">Save</button>
                    <button @onclick="() => employeeIdToUpdate = null">Cancel</button>
                }
                else
                {
                    <button @onclick="() => StartEdit(employee)">Edit</button>
                }
                
                </td>
                <button @onclick="() => employeeIdToDelete = employee.Id ">Delete</button>
                @if (employeeIdToDelete == employee.Id)
                {
                    <label>Are you sure?</label>
                    <button @onclick="() => DeleteEmployee(employee.Id)">Confirm</button>
                    <button @onclick="() => employeeIdToDelete = null">Cancel</button>
                }
            </tr>    
        }
    </tbody>
</table>




@code {
    private int employeeCount = 0;

    private string employeeName="";
    private string employeeDepartment="";
    private string errorMessage = "";
    private int? employeeIdToDelete;
    private int? employeeIdToUpdate;
    private string? editName = "";
    private string? editDepartment = "";
    private string? searchContent = "";
    private bool hasSearched = false;
    private string searchMessage = "";

    private List<Employee> employees = new();

    protected override async Task OnInitializedAsync()
    {
        employeeCount = await employeeService.GetEmployeeCountAsync();
        employees = await employeeService.GetEmployeesAsync();
    }

    private async Task AddEmployee()
    {
        if (!string.IsNullOrWhiteSpace(employeeName) && !string.IsNullOrWhiteSpace(employeeDepartment))
        {
            Employee employee = new Employee
                {
                    Name = employeeName,
                    Department = employeeDepartment,
                    HireDate = DateTime.Today
                };

            try
            {
                await employeeService.AddEmployeeAsync(employee);
                employeeCount = await employeeService.GetEmployeeCountAsync();
                employees = await employeeService.GetEmployeesAsync();

                employeeName = "";
                employeeDepartment = "";
                errorMessage = "";
            }
            catch(ArgumentException ex)
            {
                errorMessage = ex.Message;
            }
            catch(Exception ex)
            {
                errorMessage = "An unexpected error occured while saving.";
                Console.WriteLine(ex);
            }

        }
        else
        {
            errorMessage = "Please fill in all fields.";
        }
    }

    private async Task DeleteEmployee(int id)
    {
        try
        {
            await employeeService.DeleteEmployeeAsync(id);

            employees = await employeeService.GetEmployeesAsync();
            employeeCount = await employeeService.GetEmployeeCountAsync();

            employeeIdToDelete = null;
            errorMessage = "";
        }
        catch(KeyNotFoundException ex)
        {
            errorMessage = ex.Message;
        }
        catch(Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void StartEdit(Employee employee)
    {
        employeeIdToUpdate = employee.Id;
        editName = employee.Name;
        editDepartment = employee.Department;
    }

    private async Task UpdateEmployee(int id, string name, string department)
    {
        try
        {
            await employeeService.UpdateEmployeeAsync(id, name, department);
            employees = await employeeService.GetEmployeesAsync();
            employeeIdToUpdate = null;

            errorMessage = "";
        }
        catch (KeyNotFoundException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

    }

    private async Task SearchEmployee(string search)
    {

        if (string.IsNullOrWhiteSpace(search))
        {
            searchMessage = "Please enter a value!";
            hasSearched = false;
            return;
        }
        employees = await employeeService.SearchEmployeesAsync(search);

        hasSearched = true;
        if(employees.Count == 0)
        {
            searchMessage = "There is no record";
        }

        else 
        {
            searchMessage = $"{employees.Count} record found out of {employeeCount} records.";
 
        }

        
    }
}
